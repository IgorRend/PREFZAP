# ======= Banco de Dados =======
DATABASE_URL="file:./dev.db"

# ======= Segurança (JWT e Criptografia) =======
# IMPORTANTE: Gere uma chave aleatória forte para produção!
# Exemplo: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="CHANGE_ME_IN_PRODUCTION"
JWT_EXPIRES_IN="7d"
APP_SECRET_KEY="CHANGE_ME_IN_PRODUCTION"

# ======= Fila e Cache =======
REDIS_URL="redis://localhost:6379"

# ======= SMTP (Disparo de E-mails) =======
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# ======= Evolution GO (Motor Único Omnichannel) =======
EVOLUTION_API_URL="http://localhost:8080"
EVOLUTION_API_KEY=""

# Token de autenticação do webhook — OBRIGATÓRIO para validar payloads do Evolution GO
# Deve ser um UUID ou string aleatória. Configure-o como verify_token no Evolution GO.
WEBHOOK_TOKEN=""

# Onde o Evolution GO vai entregar as mensagens
APP_WEBHOOK_URL="http://localhost:3001/api/webhooks/evolution"

# ======= Servidor SaaS =======
PORT=3001
FRONTEND_URL="http://localhost:5173"
